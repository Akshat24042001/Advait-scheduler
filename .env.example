# ─────────────────────────────────────────────────────────────────────────────
# ADVAIT Scheduler — Environment Variables
# Copy this file to .env.local for local dev.
# Set these same variables in Vercel Dashboard → Project Settings → Environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (OPTIONAL — app works without these using in-memory dummy data) ─
# Get both values from: supabase.com → your project → Settings → API

# Your project URL (looks like: https://xyzxyzxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Service Role secret key — NOT the anon key. Keep this server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron / Scheduled Sends (OPTIONAL) ────────────────────────────────────────
# Set a random secret string. Use it as the x-cron-secret header when calling
# POST /api/send from a cron job (e.g. Vercel Cron, GitHub Actions schedule).
# Example: openssl rand -hex 32
CRON_SECRET=change-me-to-any-random-string
